# ============================================================
# ClotoCore Configuration Template
# Copy to .env and fill in your values.
# ============================================================

# --- Server ---
PORT=8081
RUST_LOG=info

# --- Security (Principle #5: Strict Permission Isolation) ---
# Admin API key for protected endpoints (plugin config, permissions, shutdown).
# REQUIRED in release builds. Generate with: openssl rand -hex 32
CLOTO_API_KEY=

# --- Database ---
# SQLite database path. Parent directory is created automatically at startup.
# DATABASE_URL=sqlite:./data/cloto_memories.db

# --- AI Provider API Keys ---
# DEEPSEEK_API_KEY=
# CEREBRAS_API_KEY=
# EMBEDDING_API_KEY=

# --- Plugin server keys ---
# Read by the plugin servers themselves, not by the kernel. Listed here
# because this file is what the README tells you to copy.
# TAVILY_API_KEY=

# --- Ollama (local LLM) ---
# OLLAMA_MODEL=qwen3:30b-a3b-q4_K_M
# OLLAMA_ENABLE_THINKING=true

# --- MCP (Model Context Protocol) ---
# Path to MCP server configuration file.
# Default: {exe_dir}/data/mcp.toml
CLOTO_MCP_CONFIG=mcp.toml

# --- Consensus (Principle #8: Dynamic Intelligence Orchestration) ---
# CONSENSUS_ENGINES=mind.deepseek,mind.cerebras

# --- Agent ---
# DEFAULT_AGENT_ID=agent.cloto_default

# --- Tuning ---
# MAX_EVENT_DEPTH=10                    # Range: 1-50
# PLUGIN_EVENT_TIMEOUT_SECS=30          # Range: 1-300
# MEMORY_CONTEXT_LIMIT=10
# EVENT_HISTORY_SIZE=1000
# EVENT_RETENTION_HOURS=24              # Range: 1-720

# --- Agentic ---
# CLOTO_MAX_AGENTIC_ITERATIONS=16       # Range: 1-64
# CLOTO_TOOL_TIMEOUT_SECS=30            # Range: 1-300
# HEARTBEAT_INTERVAL_SECS=30

# --- Network ---
# Bind address: defaults to 127.0.0.1, limiting the listener to this host.
# Set to 0.0.0.0 to allow access from other hosts on the network.
# The loopback default is not a security boundary — if you put a tunnel or reverse
# proxy in front of this kernel (cloudflared, ngrok, nginx), it reaches the listener
# no matter what BIND_ADDRESS says. Protect it with authentication, not the bind.
# BIND_ADDRESS=127.0.0.1
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ALLOWED_HOSTS=
